    <string name="settings_about">About WideQR</string>
    <string name="settings_about_desc">WideQR prioritizes genuine physical ultra-wide lens access via Camera2 without digital zoom tricks. On devices whose firmware restricts secondary sensors from third-party apps, WideQR reports that limitation honestly.</string>
