    <string name="settings_camera_diagnostics">Camera Diagnostics</string>
    <string name="settings_camera_diagnostics_desc">Inspect Camera2 physical IDs, focal lengths, and sensor metadata</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_desc">All QR decoding runs locally on your device. Camera frames are never uploaded, and there are no ads, accounts, or analytics. Network requests happen only if you tap Inspect Redirects or open a link. Scan history is off by default — if you turn it on, results are stored only on this device and you can clear them at any time.</string>
    <string name="settings_scanner_behaviour">Scanner Behaviour</string>
    <string name="settings_main_camera_fallback">Allow 1x main camera fallback</string>
    <string name="settings_main_camera_fallback_desc">When the ultra-wide lens is locked by firmware, scan with the standard 1x main camera instead. The scanner will clearly label this as a fallback, and images will be less sharp — your ultra-wide is still preferred whenever it is available.</string>
    <string name="settings_product_barcodes">Scan product &amp; 1D barcodes</string>
    <string name="settings_product_barcodes_desc">Also decode EAN, UPC, Code 128, Code 39, ITF, Data Matrix and Aztec codes. Off by default because wider format scanning adds latency on low-RAM devices.</string>
    <string name="settings_scan_history">Save scan history</string>
    <string name="settings_scan_history_desc">Keep the codes you scan in a local on-device list. Nothing is uploaded, and you can clear everything at once.</string>
    <string name="settings_history_clear">Clear scan history</string>
    <string name="settings_history_cleared">Scan history cleared</string>
